<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#FFF8FC"
    android:padding="20dp">

    <Button
        android:id="@+id/btnBack"
        android:layout_width="80dp"
        android:layout_height="45dp"
        android:text="Back" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Growth Chart"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp" />

    <EditText
        android:id="@+id/etWeight"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:hint="Enter Weight kg"
        android:layout_marginTop="20dp" />

    <EditText
        android:id="@+id/etHeight"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:hint="Enter Height cm" />

    <Button
        android:id="@+id/btnSaveGrowth"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="Save Growth Entry"
        android:layout_marginTop="15dp" />

    <Button
        android:id="@+id/btnShareSummary"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="Share Growth Summary"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvGrowthData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No chart data available"
        android:textColor="#F4A261"
        android:layout_marginTop="80dp" />

</LinearLayout>