<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5EFF7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="25dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:text="Back"
            android:backgroundTint="#5D117A"
            android:textColor="#FFFFFF"/>

        <EditText
            android:id="@+id/etVaccineName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Vaccine Name"
            android:layout_marginTop="25dp"/>

        <EditText
            android:id="@+id/etVaccineDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Vaccine Date"/>

        <Button
            android:id="@+id/btnSaveReminder"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Save Reminder"
            android:backgroundTint="#5D117A"
            android:textColor="#FFFFFF"
            android:layout_marginTop="20dp"/>

        <ListView
            android:id="@+id/listVaccines"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

</ScrollView>